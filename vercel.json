{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(json|js|css|svg|woff2|jpg|png|xml|txt|ico|webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/arcade/flappy-bird/:path*", "destination": "/apps/flappy-bird/", "permanent": false },
    { "source": "/arcade/flappy-bird", "destination": "/apps/flappy-bird/", "permanent": false },
    { "source": "/arcade/crossy-road/:path*", "destination": "/apps/crossy-road/", "permanent": false },
    { "source": "/arcade/crossy-road", "destination": "/apps/crossy-road/", "permanent": false },
    { "source": "/arcade/slope/:path*", "destination": "/apps/slope/", "permanent": false },
    { "source": "/arcade/slope", "destination": "/apps/slope/", "permanent": false },
    { "source": "/arcade/bad-ice-cream/:path*", "destination": "/apps/bad-ice-cream/", "permanent": false },
    { "source": "/arcade/bad-ice-cream", "destination": "/apps/bad-ice-cream/", "permanent": false },
    { "source": "/arcade/bad-ice-cream-2/:path*", "destination": "/apps/bad-ice-cream/", "permanent": false },
    { "source": "/arcade/bad-ice-cream-3/:path*", "destination": "/apps/bad-ice-cream/", "permanent": false },
    { "source": "/arcade/doom-1993/:path*", "destination": "/apps/doom/", "permanent": false },
    { "source": "/arcade/doom/:path*", "destination": "/apps/doom/", "permanent": false },
    { "source": "/arcade/cookie-clicker/:path*", "destination": "/apps/cookie-clicker/", "permanent": false },
